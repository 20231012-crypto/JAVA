# Build output
/target/

# Maven wrapper downloads the real distribution here on first run — don't track it
/.mvn/wrapper/maven-wrapper.jar

# Local secrets — copy the .example file and fill in your own values
src/main/resources/db.properties
src/main/resources/app.properties
.env

# Claude Code runtime state (session-local, not project content)
.claude/scheduled_tasks.lock

# IDE metadata
.classpath
.project
.settings/
.idea/
*.iml
.vscode/

# Downloaded Claude Code skill content — regenerate via the command in the plan's
# "Claude Code tooling setup" section (skills-lock.json is tracked so it can be restored)
/.agents/
/.claude/skills/design-taste-frontend

# OS cruft
.DS_Store
Thumbs.db
