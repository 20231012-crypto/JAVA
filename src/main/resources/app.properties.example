# Directory where uploaded product images are stored (outside the deployed WAR so
# they survive Tomcat re-exploding the webapp on every redeploy). Must exist and be writable.
upload.dir=C:/eaut-canteen-uploads

# VietQR bank-transfer config, used to render the payment QR at checkout/order-detail.
vietqr.bankId=970436
vietqr.accountNo=0000000000
vietqr.accountName=CANTEEN EAUT

# Google Sign-In (customer login/registration only — staff still use username+password).
# Any Google account can sign in, there is no email-domain restriction.
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console > APIs & Services >
# Credentials: add every origin you test from (e.g. http://localhost:8080) under "Authorized
# JavaScript origins", AND add the exact login callback URL (e.g.
# http://localhost:8080/canteen-webapp/auth/google) under "Authorized redirect URIs" — both are
# required by the button's redirect flow. Then paste the client ID below.
google.clientId=YOUR_CLIENT_ID.apps.googleusercontent.com

# EAUT Smart ID automatic discount (whole percent, applied to subtotal at checkout) for any
# customer whose email ended in @eaut.edu.vn at signup (see GoogleAuthServlet). Optional —
# CheckoutServlet defaults to 10 if this key is absent.
smartId.discountPercent=10

# Tích điểm (loyalty points): customers earn floor(order total / vndPerPoint) points when an
# ONLINE order they placed is marked COMPLETED (see OrderFulfillmentServlet), and can redeem
# points at checkout for redeemValuePerPoint đồng off each (see CheckoutServlet). Both optional —
# default to the values below if absent. Note redeemValuePerPoint * vndPerPoint's implied "give
# back rate" is intentionally less than 100% (500 vs 10000 here = 5%) — a real loyalty program
# that paid back 1:1 what it cost to earn would just be a price cut with extra steps.
loyalty.vndPerPoint=10000
loyalty.redeemValuePerPoint=500
